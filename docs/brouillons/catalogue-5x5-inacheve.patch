+/** Percentile (0 à 1) d'un histogramme de valeurs numériques : plus petite valeur dont la part cumulée atteint p. */
+function percentileHist(h, p) {
+  const ks = cles(h).filter((k) => k !== 'n/a').map(Number), tot = ks.reduce((s, k) => s + h[String(k)], 0);
+  let cum = 0;
+  for (const k of ks) { cum += h[String(k)]; if (cum / tot >= p - 1e-12) return k; }
+  return NaN;
+}
+
+/**
+ * Mesure exhaustive des 11 440 placements sur `docs` (plateaux déjà réparés) avec l'évaluation rapide, regroupés par
+ * classe de symétrie. Renvoie une liste triée du meilleur au moins bon :
+ * { cle, masque, images, n, sMoyen, bloque, cinq, ecart3, s5, egale, inegaleN, villes (liste) }.
+ */
+function classerPlacements5(docs) {
+  const classes = new Map();
+  const contextes = docs.map((doc) => contexteRapide5(GR.construire(doc, { jetons: [] })));
+  for (const masque of COMBINAISONS5) {
+    const cl = classeMasque5(masque);
+    let c = classes.get(cl);
+    if (!c) { c = { masque: cl, images: new Set(), n: 0, sommeS: 0, bloque: 0, cinq: 0, ecart3: 0, s5: 0, inegale: 0, inaccessible: 0, t: 0 }; classes.set(cl, c); }
+    c.images.add(masque);
+    for (const ctx of contextes) {
+      const e = evaluerRapide5(ctx, masque);
+      c.n++;
+      if (!e.ok) { c.inaccessible++; continue; }
+      c.sommeS += e.S;
+      if (e.bloque) c.bloque++;
+      if (e.cinq) c.cinq++;
+      if (e.ecartMax > 2) c.ecart3++;
+      if (e.S >= GR.SEUIL_S) c.s5++;
+      if (!e.egale) c.inegale++;
+      c.t += e.t1 + e.t2;
+    }
+  }
+  const liste = [];
+  for (const c of classes.values()) {
+    const ok = c.n - c.inaccessible;
+    liste.push({
+      cle: cleVilles5(c.masque), masque: c.masque, images: c.images.size, n: c.n,
+      sMoyen: c.sommeS / ok, bloque: c.bloque / c.n, cinq: c.cinq / c.n, ecart3: c.ecart3 / c.n, s5: c.s5 / c.n,
+      inegale: c.inegale / c.n, inaccessible: c.inaccessible / c.n, tempo3: c.t / (2 * ok)
+    });
+  }
+  liste.sort((a, b) => a.bloque - b.bloque || a.sMoyen - b.sMoyen || a.masque - b.masque);
+  return liste;
+}
+
+/** Répartition des villes par ligne de jonctions (j = 1 à 4) : texte « 2-2-2-1 ». */
+function repartitionLignes5(masque) {
+  const n = [0, 0, 0, 0];
+  JONCTIONS5.forEach((jn, k) => { if ((masque >> k) & 1) n[jn.j - 1]++; });
+  return n.join('-');
+}
+
+/**
+ * Mesure complète du catalogue 5×5. options : nb (plateaux, 1000), graine (20261016), combos (placements au hasard par
+ * plateau, 40), exhaustif (plateaux de la mesure des 11 440 placements, 1000), goulets (plateaux, 300), defaut (masque).
+ * Les tirages utilisent des flux séparés issus de la graine : « brut » (rotations quelconques), « réparé » (2 ports par
+ * jonction), « réparé pour le placement par défaut » (3 ports aux villes si possible).
+ */
+function mesurer5(options) {
+  const o = Object.assign({ nb: 1000, graine: 20261016, combos: 40, exhaustif: 1000, goulets: 300, defaut: PLACEMENT_DEFAUT_5X5 }, options);
+  const res = { options: o };
+
+  // 1. brut
+  res.brut = nouvellesProprietes5();
+  const brut = tirerPlateaux(o.nb, o.graine, GRILLE5);
+  brut.forEach((x) => { res.brut.n++; proprietesPlateau5(x.doc, res.brut); });
+  res.brutDocs = brut.map((x) => x.doc);
+
+  // 2. réparé (2 ports par jonction)
+  res.repare = nouvellesProprietes5();
+  const rngR = mulberry32(o.graine + 1);
+  const essais = {}, manques = {};
+  const docsR = [];
+  for (let n = 0; n < o.nb; n++) {
+    const t = tirerPlateauRepare5(rngR, 0, 100);
+    ajouterHist(essais, t.essais); ajouterHist(manques, t.manque);
+    docsR.push(t.doc);
+  }
+  res.essais = essais; res.manques = manques;
+  res.docsR = docsR;
+  const graphesR = docsR.map((doc) => { res.repare.n++; return proprietesPlateau5(doc, res.repare); });
+  res.graphesR = graphesR;
+
+  // 3. flancs (graphe.flancs, villes non traversables), sur le tirage réparé
+  res.flancs = { plusCourt: 0, n: 0, diff: [] };
+  docsR.slice(0, Math.min(o.nb, 300)).forEach((doc) => {
+    for (const f of GR.flancs(doc, { villesTraversables: false })) {
+      res.flancs.n++;
+      if (f.flanc < f.centre) res.flancs.plusCourt++;
+      res.flancs.diff.push(f.flanc - f.centre);
+    }
+  });
+
+  // 4. équilibre sur des placements tirés au hasard (tous les placements possibles ont la même chance)
+  const rngC = mulberry32(o.graine + 2);
+  res.hasard = evaluerPlateaux5(docsR, () => {
+    const l = [];
+    for (let k = 0; k < o.combos; k++) l.push(COMBINAISONS5[Math.floor(rngC() * COMBINAISONS5.length)]);
+    return l;
+  }, { graphes: graphesR });
+
+  // 5. classement des 11 440 placements (évaluation rapide) sur les premiers plateaux réparés
+  const nbEx = Math.min(o.exhaustif, o.nb);
+  res.nbExhaustif = nbEx;
+  res.classement = classerPlacements5(docsR.slice(0, nbEx));
+  res.classementTotal = COMBINAISONS5.length;
+
+  // 6. placement par défaut : sauf indication contraire, parmi les classes sans blocage ni première ville inégale dont le
+  //    S moyen est le plus bas (40 candidates), celle dont les 3 ports aux villes se réparent le plus souvent
+  res.candidats = [];
+  if (o.defaut === null || o.defaut === undefined) {
+    const rngF = mulberry32(o.graine + 4);
+    const retenues = res.classement.filter((c) => c.bloque === 0 && c.inegale === 0).slice(0, 40);
+    for (const c of retenues) {
+      let ok = 0;
+      for (let n = 0; n < 60; n++) if (tirerPlateauRepare5(rngF, c.masque, 30).manque === 0) ok++;
+      res.candidats.push({ cle: c.cle, masque: c.masque, sMoyen: c.sMoyen, s5: c.s5, faisabilite: ok / 60 });
+    }
+    res.candidats.sort((a, b) => b.faisabilite - a.faisabilite || a.sMoyen - b.sMoyen);
+    res.defaut = res.candidats[0].masque;
+  } else {
+    res.defaut = o.defaut;
+  }
+  res.defautEntree = res.classement.find((c) => c.masque === classeMasque5(res.defaut));
+  res.surDefaut = evaluerPlateaux5(docsR, () => [res.defaut], { graphes: graphesR, goulets: o.goulets });
+  // 7. plateaux réparés pour ce placement (3 ports aux villes si possible)
+  const rngD = mulberry32(o.graine + 3);
+  const docsD = [], manquesD = {};
+  for (let n = 0; n < o.nb; n++) { const t = tirerPlateauRepare5(rngD, res.defaut, 100); docsD.push(t.doc); ajouterHist(manquesD, t.manque); }
+  res.manquesD = manquesD;
+  res.surDefautRepare = evaluerPlateaux5(docsD, () => [res.defaut], { goulets: o.goulets });
+  res.docsD = docsD;
+  return res;
+}
